#!/usr/bin/env bash
set -euo pipefail

case ${1:-} in
    configure|uninstall)
        operation=$1
        shift
        helper="$PREFIX/libexec/muxtops/$operation.sh"
        [[ -f $helper ]] || { echo 'Run install.sh to install the management commands.' >&2; exit 1; }
        exec bash "$helper" "$@"
        ;;
esac

state=${XDG_STATE_HOME:-$HOME/.local/state}/muxtops
config=${XDG_CONFIG_HOME:-$HOME/.config}/muxtops
display=:1
port=5901
listen_address=127.0.0.1
if [[ -f $config/vnc-address ]]; then
    read -r listen_address < "$config/vnc-address"
fi
[[ $listen_address =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    echo 'vnc-address must contain one IPv4 address.' >&2
    exit 1
}
mkdir -p "$state" "$config"

# Compare the process birth time as well as PID. A stale PID file must never
# let stop signal an unrelated process after Android has recycled its PID.
process_birth() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
alive() {
    local pid birth current
    [[ -s $state/session.pid ]] || return 1
    read -r pid birth < "$state/session.pid" || return 1
    [[ $pid =~ ^[0-9]+$ && $birth =~ ^[0-9]+$ ]] || return 1
    current=$(process_birth "$pid") || return 1
    [[ $current == "$birth" ]] && kill -0 "$pid" 2>/dev/null
}

session() {
    local xpid='' wpid='' bpid='' ppid='' ready=0
    cleanup() {
        trap - EXIT
        for pid in "$ppid" "$wpid" "$bpid" "$xpid"; do
            [[ -z $pid ]] || kill "$pid" 2>/dev/null || true
        done
        for pid in "$ppid" "$wpid" "$bpid" "$xpid"; do
            [[ -z $pid ]] || wait "$pid" 2>/dev/null || true
        done
        rm -f "$state/session.pid" "$state/ready" "$state/dbus-address"
    }
    trap cleanup EXIT
    trap 'exit 0' TERM INT HUP
    export DISPLAY=$display
    Xvnc "$display" -nolisten tcp -interface "$listen_address" -rfbport "$port" \
        -rfbauth "$config/passwd" -geometry 1280x720 -depth 24 &
    xpid=$!
    for ((attempt=0; attempt<100; attempt++)); do
        kill -0 "$xpid" 2>/dev/null || { echo 'Xvnc failed.'; exit 1; }
        if xrdb -display "$display" -query >/dev/null 2>&1; then
            ready=1
            break
        fi
        sleep 0.1
    done
    [[ $ready == 1 ]] || { echo 'X server readiness timed out.'; exit 1; }
    : > "$state/dbus-address"
    dbus-daemon --session --nofork --print-address=3 3>"$state/dbus-address" &
    bpid=$!
    for ((attempt=0; attempt<50; attempt++)); do
        [[ -s $state/dbus-address ]] && break
        kill -0 "$bpid" 2>/dev/null || exit 1
        sleep 0.1
    done
    [[ -s $state/dbus-address ]] || exit 1
    export DBUS_SESSION_BUS_ADDRESS
    DBUS_SESSION_BUS_ADDRESS=$(head -n 1 "$state/dbus-address")
    MUXTOPS_CONFIG=$config bash -ec '
        if [[ -f $MUXTOPS_CONFIG/wallpaper ]]; then
            feh --bg-fill "$MUXTOPS_CONFIG/wallpaper"
        fi
        exec openbox --config-file "$MUXTOPS_CONFIG/rc.xml"
    ' &
    wpid=$!
    mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/tint2"
    tint2 -c "$config/tint2rc" &
    ppid=$!
    ready=0
    for ((attempt=0; attempt<100; attempt++)); do
        for pid in "$xpid" "$wpid" "$bpid" "$ppid"; do
            kill -0 "$pid" 2>/dev/null || exit 1
        done
        if xprop -root _NET_SUPPORTING_WM_CHECK | grep -q 'window id' &&
           xprop -root _NET_CLIENT_LIST | grep -q 'window id'; then
            ready=1
            break
        fi
        sleep 0.1
    done
    [[ $ready == 1 ]] || { echo 'Desktop windows did not become ready.'; exit 1; }
    touch "$state/ready"
    wait -n "$xpid" "$wpid" "$bpid" "$ppid"
}

# Android viewers such as AVNC register vnc:// links. Start before acquiring
# the lifecycle lock so the nested start command cannot deadlock.
if [[ ${1:-} == view ]]; then
    "$0" start
    exec termux-open-url "vnc://$listen_address:$port"
fi

# Serialize lifecycle operations, including concurrent start requests.
# The detached supervisor closes this descriptor so it cannot hold the lock.
if [[ ${1:-help} != _session ]]; then
    exec 9>"$state/control.lock"
    flock -w 30 9 || { echo 'Another desktop operation is busy.' >&2; exit 1; }
fi

case ${1:-help} in
    start)
        if alive; then
            [[ -f $state/ready ]] || { echo 'Desktop is still starting.' >&2; exit 1; }
            echo "Desktop already running on $listen_address:$port."
            exit 0
        fi
        [[ -s $config/passwd ]] || { echo 'Run desktop password first.' >&2; exit 1; }
        for dep in Xvnc dbus-daemon openbox xterm xrdb xprop tint2 pcmanfm; do
            command -v "$dep" >/dev/null || { echo "Missing dependency: $dep" >&2; exit 1; }
        done
        if [[ -e ${TMPDIR:-$PREFIX/tmp}/.X11-unix/X1 || -e ${TMPDIR:-$PREFIX/tmp}/.X1-lock ]]; then
            echo 'Display :1 is occupied. Check the existing server before starting.' >&2
            exit 1
        fi
        [[ -f $config/rc.xml ]] || { echo 'Missing config: run install.sh.' >&2; exit 1; }
        rm -f "$state/ready"
        nohup "$0" _session 9>&- </dev/null >"$state/desktop.log" 2>&1 &
        supervisor=$!
        printf '%s %s\n' "$supervisor" "$(process_birth "$supervisor")" > "$state/session.pid"
        for ((attempt=0; attempt<250; attempt++)); do
            alive || break
            [[ -f $state/ready ]] && break
            sleep 0.1
        done
        if alive && [[ -f $state/ready ]]; then
            echo "Desktop ready: $listen_address:$port."
        else
            if alive; then kill "$supervisor"; fi
            wait "$supervisor" 2>/dev/null || true
            cat "$state/desktop.log" >&2
            exit 1
        fi
        ;;
    stop)
        if alive; then
            read -r supervisor _ < "$state/session.pid"
            kill "$supervisor"
            for ((attempt=0; attempt<100; attempt++)); do
                alive || break
                sleep 0.1
            done
            if alive; then echo 'Desktop did not stop; inspect desktop log.' >&2; exit 1; fi
            echo 'Desktop stopped.'
        else
            echo 'Desktop is stopped.'
        fi
        ;;
    status)
        if alive && [[ -f $state/ready ]]; then
            echo "Running: $listen_address:$port"
        else
            echo 'Stopped'
            exit 1
        fi
        ;;
    log) tail -n 80 "$state/desktop.log" ;;
    info)
        printf 'VNC server: %s\nPort: %s\nOn this phone: open AVNC (or another VNC viewer) and use the address above.\n' "$listen_address" "$port"
        printf 'Start: desktop start | Stop: desktop stop\n'
        ;;
    password)
        if alive; then echo 'Stop the desktop before changing its password.' >&2; exit 1; fi
        vncpasswd "$config/passwd"
        chmod 600 "$config/passwd"
        ;;
    _session) session ;;
    help|--help|-h) printf '%s\n' 'Usage: desktop {start|stop|status|view|info|configure|uninstall|log|password}' ;;
    *) echo "Unknown command: $1" >&2; exit 2 ;;
esac
